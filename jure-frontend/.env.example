# =============================================================================
# Jure frontend → Django API (Vite)
# =============================================================================
# REST base URL sent by the app: ${API_ORIGIN}/api/v1/
# Set ONE of these to the backend origin (no /api/v1 required; it is appended once).
#
# Examples:
#   VITE_API_URL=http://localhost:8000
#   VITE_API_URL=https://api.example.com
#
# If you already include /api/v1 in the value, it is stripped so paths never double.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_API_URL=http://localhost:8000

# Optional: WebSocket host (defaults to same host as API, ws/wss from http/https)
# VITE_WS_BASE=ws://localhost:8000

# Legacy / alternate names (see src/config/api.ts load order)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# REACT_APP_API_URL=http://localhost:8000
