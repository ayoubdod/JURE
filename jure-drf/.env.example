# Django
# Local default for manage.py / runserver only.
# Docker bakes core.settings.staging; docker-entrypoint.sh also coerces
# empty/local overrides away from core.settings.local.
# On Railway, set (or leave unset — image default is staging):
#   DJANGO_SETTINGS_MODULE=core.settings.staging
# NEVER set DJANGO_SETTINGS_MODULE=core.settings.local on Railway.
DJANGO_SETTINGS_MODULE=core.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Temporary: enable GET /debug/settings on staging (DEBUG must be False)
ENABLE_DEPLOYMENT_DEBUG=False
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# URLs
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# Hosts & CORS (comma-separated for staging/production)
# Railway: include your public host, e.g.
#   ALLOWED_HOSTS=jure-production-a298.up.railway.app
# staging.py also adds BACKEND_BASE_URL hostname and RAILWAY_PUBLIC_DOMAIN.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Uploads (profile photos, cabinet logos, library files, chat attachments)
# Railway wipes the container filesystem on every deploy. Postgres keeps the
# file *paths*, so images look deleted. Attach a Volume to this service:
#   Volume mount path: /data/media
#   MEDIA_ROOT=/data/media
# One replica only — volumes are not shared across multiple Railway instances.
# MEDIA_ROOT=

# Database (staging/production — SQLite is used automatically in local)
# Railway (REQUIRED on the Django/web service — not automatic just because
# Postgres exists in the project):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Prefer private DATABASE_URL over DATABASE_PUBLIC_URL.
# Optional: DB_SSLMODE=require | disable | prefer
# Optional: CONN_MAX_AGE=60
DATABASE_URL=postgres://user:password@localhost:5432/jure
# DATABASE_PUBLIC_URL=
# DB_SSLMODE=
# CONN_MAX_AGE=60

# Redis / Channels (staging calls need Redis if you scale past 1 Daphne process)
REDIS_URL=redis://127.0.0.1:6379/0
USE_INMEMORY_CHANNEL_LAYER=True

# Email (SMTP_* takes precedence over EMAIL_*)
# Without SMTP_PASS / RESEND_API_KEY, Django prints mail to the terminal.
DEFAULT_FROM_EMAIL=JURE <contact@jure.ma>
CONTACT_INBOX=contact@jure.ma
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Integrations
ASANA_TOKEN=

# WebRTC TURN (needed on staging/production across NATs; local often works with STUN only)
# Prefer TURN_SECRET (coturn use-auth-secret) for time-limited credentials served via GET /calls/ice-servers/
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=
TURN_SECRET=
TURN_CREDENTIAL_TTL=86400
# Fallback static credentials if TURN_SECRET is unset
TURN_USERNAME=
TURN_CREDENTIAL=

# Juria AI (backend proxy only — never expose API keys to the frontend)
# Railway Django service MUST set these at runtime (.env is not loaded in staging/production):
#   JURIA_ENABLED=True
#   JURIA_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=...
#   DEEPSEEK_API_URL=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-chat
JURIA_PROVIDER=deepseek
JURIA_ENABLED=False
JURIA_MAX_TOKENS=4000
JURIA_TIMEOUT_SECONDS=90
# DeepSeek (https://platform.deepseek.com) — used when JURIA_PROVIDER=deepseek
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Legacy custom Juria API — used when JURIA_PROVIDER=juria
JURIA_API_URL=https://api.juria.ma/v1
JURIA_API_KEY=

# Production security (production.py only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
