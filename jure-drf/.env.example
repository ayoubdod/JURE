# Django
DJANGO_SETTINGS_MODULE=core.settings.local
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# URLs
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# Hosts & CORS (comma-separated for staging/production)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Database (staging/production — SQLite is used automatically in local)
DATABASE_URL=postgres://user:password@localhost:5432/jure

# Redis / Channels
REDIS_URL=redis://127.0.0.1:6379/0
USE_INMEMORY_CHANNEL_LAYER=True

# Email (SMTP_* takes precedence over EMAIL_*)
DEFAULT_FROM_EMAIL=webmaster@localhost
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True

# Integrations
ASANA_TOKEN=

# WebRTC TURN (optional — STUN is served via API without env)
TURN_HOST=
TURN_PORT=3478
TURN_USERNAME=
TURN_CREDENTIAL=

# Juria AI (backend proxy only — never expose JURIA_API_KEY to the frontend)
JURIA_API_URL=https://api.juria.ma/v1
JURIA_API_KEY=
JURIA_MAX_TOKENS=4000
JURIA_TIMEOUT_SECONDS=60
JURIA_ENABLED=True

# Production security (production.py only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
