#: .\users\serializers.py:143
msgid "National identity card front is required for artisan accounts."
msgstr "الوجه الأمامي لبطاقة الهوية الوطنية مطلوب لحسابات الحرفيين."

#: .\users\serializers.py:146
msgid "National identity card back is required for artisan accounts."
msgstr "الوجه الخلفي لبطاقة الهوية الوطنية مطلوب لحسابات الحرفيين."

#: .\users\serializers.py:150
