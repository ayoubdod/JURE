msgstr "الرقم الضريبي مطلوب لحسابات الشركات."

#: .\users\serializers.py:165
msgid "ICE is required for company accounts."
msgstr "ICE مطلوب لحسابات الشركات."

#: .\users\serializers.py:169
msgid "ICE is required for auto entrepreneur accounts."
msgstr "ICE مطلوب لحسابات رجال الأعمال المستقلين."

